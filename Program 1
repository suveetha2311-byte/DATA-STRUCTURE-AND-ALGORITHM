#include <stdio.h>
#include <stdlib.h>

struct node
{
    int info;
    struct node *ptr;
} *top, *top1, *temp;

int count = 0;

int topelement();
void push(int data);
void pop();
void empty();
void display();
void destroy();
void stack_count();
void create();

int main()
{
    int no, ch, e;

    printf("\n1 - Push");
    printf("\n2 - Pop");
    printf("\n3 - Top");
    printf("\n4 - Empty");
    printf("\n5 - Exit");
    printf("\n6 - Display");
    printf("\n7 - Stack Count");
    printf("\n8 - Destroy Stack");

    create();

    while (1)
    {
        printf("\n\nEnter choice : ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                printf("Enter data : ");
                scanf("%d", &no);
                push(no);
                break;

            case 2:
                pop();
                break;

            case 3:
                if (top == NULL)
                    printf("No elements in stack");
                else
                {
                    e = topelement();
                    printf("\nTop element : %d", e);
                }
                break;

            case 4:
                empty();
                break;

            case 5:
                exit(0);

            case 6:
                display();
                break;

            case 7:
                stack_count();
                break;

            case 8:
                destroy();
                break;

            default:
                printf("\nWrong choice, Please enter correct choice");
        }
    }

    return 0;
}

/* Create empty stack */
void create()
{
    top = NULL;
}

/* Count stack elements */
void stack_count()
{
    printf("\nNo. of elements in stack : %d", count);
}

/* Push data into stack */
void push(int data)
{
    temp = (struct node *)malloc(sizeof(struct node));

    if (temp == NULL)
    {
        printf("\nMemory allocation failed");
        return;
    }

    temp->info = data;
    temp->ptr = top;
    top = temp;

    count++;

    printf("\n%d pushed into stack", data);
}

/* Display stack elements */
void display()
{
    top1 = top;

    if (top1 == NULL)
    {
        printf("\nStack is empty");
        return;
    }

    printf("\nStack elements: ");

    while (top1 != NULL)
    {
        printf("%d ", top1->info);
        top1 = top1->ptr;
    }
}

/* Pop operation on stack */
void pop()
{
    top1 = top;

    if (top1 == NULL)
    {
        printf("\nError: Trying to pop from empty stack");
        return;
    }

    printf("\nPopped value : %d", top->info);

    top = top->ptr;
    free(top1);

    count--;
}

/* Return top element */
int topelement()
{
    return top->info;
}

/* Check if stack is empty or not */
void empty()
{
    if (top == NULL)
        printf("\nStack is empty");
    else
        printf("\nStack is not empty with %d elements", count);
}

/* Destroy entire stack */
void destroy()
{
    top1 = top;

    while (top1 != NULL)
    {
        top = top1->ptr;
        free(top1);
        top1 = top;
    }

    top = NULL;
    count = 0;

    printf("\nAll stack elements destroyed");
}


